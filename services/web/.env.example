# Next.js loads `.env.local` automatically. Public vars must start with NEXT_PUBLIC_.
#
# MONGODB_URL=mongodb://localhost:27017/mock-ad-tester

# --- Meta Conversions API (all optional — sink disabled when unset) ---
# Pixel + system-user token from Events Manager → Settings → Conversions API.
# META_PIXEL_ID=1234567890
# META_CAPI_TOKEN=EAAB...
# META_GRAPH_VERSION=v25.0
# Events forwarded to Meta (all events are always recorded internally):
# META_CAPI_EVENTS=session_start,swipe_depth:1,swipe_depth:4,swipe_depth:8,ad_click,article_click
# Skip events lacking fbc/fbp match keys (organic traffic). Set false to send anyway.
# META_REQUIRE_FB_IDS=true
# Events Manager → Test events tool code. REMOVE in production.
# META_TEST_EVENT_CODE=TEST12345
#
# Dual-fires a Meta standard event alongside (never replacing) the custom event
# above, for cross-advertiser training signal. Format: "event[:depth]:StandardEvent".
# See TRACKING.md for the risk tradeoffs behind this specific dictionary.
# META_STANDARD_EVENT_MAP=swipe_depth:1:ViewContent,swipe_depth:4:Lead,swipe_depth:8:AddToCart,ad_click:Subscribe,article_click:InitiateCheckout
